{
  "siteName": "Tsonic",
  "homeMount": "Home",
  "strictLinks": false,
  "search": true,
  "searchFile": "search.json",
  "mounts": [
    {
      "name": "Home",
      "source": "docs/home",
      "prefix": "/",
      "repoUrl": "https://github.com/tsoniclang/tsonic.org",
      "repoBranch": "main",
      "repoPath": "docs/home",
      "navPath": "README.md"
    },
    {
      "name": "Tsonic",
      "source": "../tsonic/docs",
      "prefix": "/tsonic/",
      "repoUrl": "https://github.com/tsoniclang/tsonic",
      "repoBranch": "main",
      "repoPath": "docs",
      "navPath": "README.md"
    },
    {
      "name": "tsbindgen",
      "source": "../tsbindgen/docs",
      "prefix": "/tsbindgen/",
      "repoUrl": "https://github.com/tsoniclang/tsbindgen",
      "repoBranch": "main",
      "repoPath": "docs",
      "navPath": "README.md"
    },
    {
      "name": "nodejs",
      "source": "../nodejs/docs",
      "prefix": "/nodejs/",
      "repoUrl": "https://github.com/tsoniclang/nodejs",
      "repoBranch": "main",
      "repoPath": "docs",
      "navPath": "README.md"
    },
    {
      "name": "js",
      "source": "../js/docs",
      "prefix": "/js/",
      "repoUrl": "https://github.com/tsoniclang/js",
      "repoBranch": "main",
      "repoPath": "docs",
      "navPath": "README.md"
    },
    {
      "name": "express",
      "source": "../express/docs",
      "prefix": "/express/",
      "repoUrl": "https://github.com/tsoniclang/express",
      "repoBranch": "main",
      "repoPath": "docs",
      "navPath": "README.md"
    }
  ]
}
