{
  "siteName": "Tsonic",
  "homeMount": "Home",
  "strictLinks": true,
  "search": true,
  "searchFile": "search.json",
  "mounts": [
    {
      "name": "Home",
      "source": "docs/home",
      "prefix": "/",
      "repoUrl": "https://github.com/tsoniclang/tsonic.org",
      "repoBranch": "main",
      "repoPath": "docs/home",
      "navPath": "README.md"
    },
    {
      "name": "Docs",
      "source": "../tsonic/docs",
      "prefix": "/docs/",
      "repoUrl": "https://github.com/tsoniclang/tsonic",
      "repoBranch": "main",
      "repoPath": "docs",
      "navPath": "README.md"
    }
  ]
}
