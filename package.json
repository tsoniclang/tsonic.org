{
  "name": "tsonic.org",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "examples:sync": "node scripts/sync-proof-examples.mjs",
    "examples:check": "node scripts/sync-proof-examples.mjs --check",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:browser": "node --test test/browser/site.browser.mjs",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
